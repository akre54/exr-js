{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "types",
    "outDir": "types",
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "dist", "test"]
}
